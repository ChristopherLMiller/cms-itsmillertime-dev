{
  "name": "cms-itsmillertime-dev",
  "version": "3.36.0",
  "description": "A blank template to get started with Payload 3.0",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "changeset": "changeset",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev --turbo",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_ENV=production NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation next lint",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "release": "pnpm build && changeset publish",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "start:prod": "node scripts/clear-dev-migration-marker.mjs && cross-env NODE_OPTIONS=--no-deprecation payload migrate && pnpm start",
    "version": "changeset version",
    "email:dev": "email dev --port 3001"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1168.0",
    "@better-auth/api-key": "^1.7.22",
    "@better-auth/passkey": "^1.7.22",
    "@delmaredigital/payload-better-auth": "^0.14.2",
    "@payloadcms/db-postgres": "3.93.0",
    "@payloadcms/email-resend": "3.93.0",
    "@payloadcms/kv-redis": "3.93.0",
    "@payloadcms/next": "3.93.0",
    "@payloadcms/payload-cloud": "3.93.0",
    "@payloadcms/plugin-cloud-storage": "3.93.0",
    "@payloadcms/plugin-ecommerce": "3.93.0",
    "@payloadcms/plugin-mcp": "3.93.0",
    "@payloadcms/plugin-search": "3.93.0",
    "@payloadcms/plugin-sentry": "3.93.0",
    "@payloadcms/plugin-seo": "3.93.0",
    "@payloadcms/richtext-lexical": "3.93.0",
    "@payloadcms/storage-s3": "3.93.0",
    "@payloadcms/ui": "3.93.0",
    "@react-email/components": "1.0.12",
    "@react-email/render": "2.3.1",
    "@sentry/nextjs": "10.78.0",
    "@seshuk/payload-plugin-openapi": "^0.2.3",
    "@veiag/payload-cmdk": "^1.3.0",
    "better-auth": "^1.7.22",
    "blurhash": "^2.0.5",
    "cross-env": "^10.1.0",
    "date-fns": "^4.4.0",
    "exifreader": "^4.54.0",
    "fast-xml-parser": "^5.12.0",
    "lucide-react": "0.556.0",
    "next": "16.4.6",
    "payload": "3.93.0",
    "payload-plugin-android-upload": "^1.0.3",
    "payload-plugin-google-photos": "^1.0.7",
    "payload-plugin-webhooks": "^1.2.0",
    "payload-sidebar-plugin": "^1.3.5",
    "pg": "8.23.1",
    "plaiceholder": "^3.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "resend": "^6.38.0",
    "sanitize-html": "^2.18.2",
    "sharp": "0.35.5",
    "slugify": "^1.6.9",
    "word-counting": "^1.1.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/eslintrc": "^3.3.7",
    "@react-email/preview-server": "5.2.10",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "eslint": "^10.14.0",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.10.1",
    "react-email": "6.11.12",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp"
    ],
    "ignoredBuiltDependencies": [
      "@sentry/cli"
    ],
    "overrides": {
      "lucide-react": "0.556.0",
      "@better-auth/utils": "0.5.1",
      "@better-auth/api-key>@better-auth/utils": "0.5.1",
      "@better-auth/passkey>@better-auth/utils": "0.5.1",
      "@better-auth/core>@better-auth/utils": "0.5.1",
      "better-call>@better-auth/utils": "0.5.1",
      "@modelcontextprotocol/sdk": "1.32.2",
      "@react-email/preview-server>next": "16.4.6",
      "monaco-editor>dompurify": "3.4.17"
    }
  }
}
