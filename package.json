{
  "name": "cms-itsmillertime-dev",
  "version": "3.27.2",
  "description": "A blank template to get started with Payload 3.0",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "changeset": "changeset",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev --turbo",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_ENV=production NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation next lint",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "release": "pnpm build && changeset publish",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "start:prod": "node scripts/clear-dev-migration-marker.mjs && cross-env NODE_OPTIONS=--no-deprecation payload migrate && pnpm start",
    "version": "changeset version",
    "email:dev": "email dev --port 3001"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1095.0",
    "@better-auth/api-key": "^1.6.25",
    "@better-auth/passkey": "^1.6.25",
    "@delmaredigital/payload-better-auth": "^0.9.2",
    "@payloadcms/db-postgres": "3.86.0",
    "@payloadcms/email-resend": "3.86.0",
    "@payloadcms/kv-redis": "^3.86.0",
    "@payloadcms/next": "3.86.0",
    "@payloadcms/payload-cloud": "3.86.0",
    "@payloadcms/plugin-cloud-storage": "3.86.0",
    "@payloadcms/plugin-ecommerce": "^3.86.0",
    "@payloadcms/plugin-mcp": "^3.86.0",
    "@payloadcms/plugin-search": "3.86.0",
    "@payloadcms/plugin-sentry": "3.86.0",
    "@payloadcms/plugin-seo": "3.86.0",
    "@payloadcms/richtext-lexical": "3.86.0",
    "@payloadcms/storage-s3": "3.86.0",
    "@payloadcms/ui": "3.86.0",
    "@react-email/components": "1.0.12",
    "@react-email/render": "2.1.0",
    "@sentry/nextjs": "10.68.0",
    "@seshuk/payload-plugin-openapi": "^0.2.0",
    "@veiag/payload-cmdk": "^1.1.0",
    "better-auth": "^1.6.25",
    "blurhash": "^2.0.5",
    "cross-env": "^10.1.0",
    "date-fns": "^4.4.0",
    "exifreader": "^4.41.3",
    "fast-xml-parser": "^5.10.1",
    "lucide-react": "0.556.0",
    "next": "16.2.12",
    "payload": "3.86.0",
    "payload-plugin-android-upload": "^1.0.3",
    "payload-plugin-webhooks": "^1.2.0",
    "payload-sidebar-plugin": "^1.3.5",
    "pg": "8.22.0",
    "plaiceholder": "^3.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.18.0",
    "sanitize-html": "^2.17.6",
    "sharp": "0.35.3",
    "slugify": "^1.6.9",
    "word-counting": "^1.1.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@eslint/eslintrc": "^3.3.6",
    "@react-email/preview-server": "5.2.10",
    "@types/node": "^25.9.3",
    "@types/pg": "^8.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/sanitize-html": "^2.16.1",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "eslint": "^10.8.0",
    "eslint-config-next": "16.2.12",
    "prettier": "^3.9.6",
    "react-email": "6.9.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp"
    ],
    "ignoredBuiltDependencies": [
      "@sentry/cli"
    ],
    "overrides": {
      "lucide-react": "0.556.0"
    }
  }
}
